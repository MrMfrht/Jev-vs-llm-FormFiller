# Every command is configured here. There are no command-line flags.
# Variables already set in your shell override this file.

# --- Shared --------------------------------------------------------------
# OpenRouter key used for Jev and Luna calls (OPENROUTER_API_KEY is also accepted).
OPEN_ROUTER_API_KEY=
# true shows the browser window and waits for Enter before closing it.
BROWSER_WATCH=false
# Pause after each browser action, in milliseconds, so a watched run is easy to follow (0 = full speed).
BROWSER_SLOW_MO_MS=0
# Optional: save a 1280x720 .webm video of each run into this folder (needs: uv run playwright install ffmpeg).
# BROWSER_VIDEO_DIR=artifacts/videos
# Seconds to wait for a Jev answer before retrying it (Jev normally answers in under 5 s).
# The LLM gets twice this, with a floor of 60 s, because its answers are longer.
MODEL_TIMEOUT_SECONDS=30
# Optional: use an installed browser instead of Playwright's Chromium, e.g. msedge or chrome.
# PLAYWRIGHT_CHANNEL=msedge

# --- Form filler: uv run python -m form_filling --------------------------
FORM_URL=https://sampleapp.tricentis.com/101/app.php
# JSON facts file; relative paths start at the repository root.
FORM_FACTS=examples/form_filling/automobile-facts.json
# Optional: exact name of a link to click before inspecting (forms behind a menu).
FORM_OPEN_LINK=Automobile
# Who matches facts to fields: jev (decision model, default) or llm (chat model with a JSON fill plan).
FORM_MATCHER=jev
# Chat model used when FORM_MATCHER=llm.
FORM_LLM_MODEL=openai/gpt-6-luna
# Model requests sent at the same time.
FORM_CONCURRENCY=4
# Optional: fewer candidate facts per request (at most 254 are used).
# FORM_FACTS_PER_REQUEST=100
# Largest request size, in estimated billed tokens, before a request is split.
FORM_TOKEN_BUDGET=100000
# Multi-select: a fact is selected when Jev's yes-probability is at least this (0-1).
FORM_MULTI_SELECT_THRESHOLD=0.6
# Single-value: a pick below this confidence is reported as needs_review and not written (0 disables).
FORM_SINGLE_VALUE_MIN_CONFIDENCE=0.6

# --- Finder: uv run python -m finder -------------------------------------
FINDER_URL=https://books.toscrape.com/
# Text in double quotes inside the goal is offered as text to type into input boxes.
FINDER_GOAL=Open the detail page of the book Sharp Objects and report its price.
# Decision budget: maximum number of actions before the run stops.
FINDER_MAX_STEPS=10
# Model that picks the evidence carried to the next page: jev or luna.
FINDER_MEMORY=jev
# Final answer style: summary (written by Luna, with citations) or extract (cited text, verbatim).
FINDER_ANSWER_MODE=summary
# Directory for JSONL run traces.
FINDER_TRACE_DIR=artifacts

# --- Page reader: uv run python -m browser -------------------------------
READER_URL=https://books.toscrape.com/
